<?xml version="1.0" encoding="utf-8"?>
<!-- Grey press-highlight for popup menu rows (mono UI, no blue). Same 30%
     mid-grey as menu_row_highlight / colorControlHighlight - no white flash.
     The white item is only the ripple MASK (bounds), not a visible colour. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D6E6E6E">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
